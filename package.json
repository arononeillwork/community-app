  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup": "bash scripts/setup.sh",
    "db:start": "bash scripts/db-start.sh",
    "db:start:full": "bash scripts/db-start.sh --full",
