# Settings for the Docker app container (docker-compose.yml).
# `npm run docker:up` copies this file to .env.docker (which is NOT committed)
# and fills in the keys printed by `npx supabase status`.
#
# The keys below are the public demo keys of the LOCAL Supabase CLI stack.
# They only work on your own machine. Never use them for a hosted deployment.

# Browser AND server use this same address, because the login cookie is named
# after the Supabase host. Needs host networking (see docker-compose.yml).
# NEXT_PUBLIC_* values are baked into the app when the image is built:
# after changing them, rebuild with `npm run docker:up`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Public address of the site, used in invite and magic-link emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only (read at runtime, never sent to the browser): used to invite residents.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Optional: serve communities on subdomains, e.g. http://oceana-gardens.lvh.me:3000
ROOT_DOMAIN=lvh.me
