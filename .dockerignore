# Keep the Docker build context small and free of secrets.

# Dependencies and build output (rebuilt inside the image)
node_modules
.next
out
build
*.tsbuildinfo

# Git and editor files
.git
.gitignore
.vscode
.idea
.DS_Store

# Secrets and local settings: env values are passed as build args / runtime env
.env*

# Supabase: the app image does not need migrations, seed or CLI state.
# (supabase/.temp and supabase/.branches hold local CLI state.)
supabase

# Tests and their output
coverage
test-results
playwright-report
blob-report
playwright/.cache

# Local tooling and docs that the app does not need at runtime
docs
scripts
*.md
Dockerfile
.dockerignore
docker-compose.yml
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
